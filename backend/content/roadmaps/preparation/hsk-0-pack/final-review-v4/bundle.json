1,"required":true}],"audio":{"asset_id":"ff7d57dc-5b57-58e4-8072-1caabca2ffad","required":false,"status":"AVAILABLE","text":null},"components":[{"character_position":0,"component":"戈","explanation":{"asset_id":null,"required":false,"status":"AVAILABLE","text":"Chưa có giải thích nguồn gốc lịch sử được xác minh (OVERLAPPING): Có thể nhận diện phần 戈 trong hình chữ; đây cũng là bộ dùng để tra chữ. Không suy ra nghĩa ‘tôi’ bằng cách cộng nghĩa các nét hoặc thành phần."},"role":"STRUCTURAL"}],"examples":{"asset_id":null,"required":false,"status":"AVAILABLE","text":"我在家。\nWǒ zài jiā.\nTôi ở nhà."},"notes":{"asset_id":null,"required":false,"status":"AVAILABLE","text":"我 dùng để nói về bản thân: tôi, mình. wǒ có thanh 3; khi đọc riêng, nghe và nhắc lại mẫu. Âm Hán Việt ‘ngã’ không phải cách phát âm Quan thoại.\n\nGhi công tư liệu:\nWei Gao, Vion Nicolas — The Shtooka Project; original bytes, no changes. Nguồn: https://commons.wikimedia.org/wiki/File:Zh-w%C7%92.ogg. Giấy phép: https://creativecommons.org/licenses/by/2.0/fr/.\nMicheletb, Yug — Wikimedia Commons CJK Stroke Order Project; original bytes, no changes. Nguồn: https://commons.wikimedia.org/wiki/File:%E6%88%91-order.gif. Giấy phép: https://creativecommons.org/licenses/by/3.0/."},"schema_version":1,"stroke_order":{"asset_id":"76680e01-e174-5fa9-a9ea-c7e2aae7c11c","required":false,"status":"AVAILABLE","text":null},"vocabulary":[{"content_version":1,"vocabulary_id":"4ae81805-45f9-5d4f-a576-2a03b4ba27c9"}]},"node_type":"NEW_WORD","position":0,"section":"hsk-0","title":"我","visual":{}},{"id":"9bc4cfdf-3aa8-5313-b9ce-4baf5e2e0c1d","lesson":{"activities":[{"automatic_snapping":false,"correct_option":null,"evaluation":"PARTICIPATION","id":"2ed3b20f-0b40-540c-9c25-495dd878e110","kind":"INTRODUCTION","options":[],"preserve_freehand":true,"prompt":"Đọc từ và nghĩa tiếng Việt.","repetitions":1,"required":true},{"automatic_snapping":false,"correct_option":null,"evaluation":"PARTICIPATION","id":"1f502d92-db59-50c4-b9fd-734f36b56e89","kind":"STROKE_ORDER","options":[],"preserve_freehand":true,"prompt":"Quan sát thứ tự nét của toàn bộ từ.","repetitions":1,"required":true},{"automatic_snapping":false,"correct_option":null,"evaluation":"PARTICIPATION","id":"a4181b88-cc7b-5b12-8c29-f433ca16d5d6","kind":"HANDWRITING","options":[],"preserve_freehand":true,"prompt":"Viết tự do từng chữ; giữ nguyên các nét đã viết.","repetitions":1,"required":true},{"automatic_snapping":false,"correct_option":null,"evaluation":"PARTICIPATION","id":"7bb37d20-6a5d-5fec-8c1d-937e52c7c216","kind":"PRONUNCIATION","options":[],"preserve_freehand":true,"prompt":"Nghe mẫu rồi đọc lại; hoạt động chỉ ghi nhận tham gia.","repetitions":2,"required":true},{"automatic_snapping":false,"correct_option":2,"evaluation":"EXACT_CHOICE","id":"e2af1e79-8a41-5d80-948c-6a9c3e088195","kind":"QUIZ","options":["nī","nì","nǐ"],"preserve_freehand":true,"prompt":"Chọn Pinyin của 你 (bạn).","repetitions":1,"required":true},{"automatic_snapping":false,"correct_option":2,"evaluation":"EXACT_CHOICE","id":"29421879-795e-5fbc-b59c-0434040e3349","kind":"QUIZ","options":["tốt","tôi","bạn"],"preserve_freehand":true,"prompt":"Chọn nghĩa của 你 (nǐ).","repetitions":1,"required":true}],"audio":{"asset_id":"c5a5f1e0-e5fe-503a-a7e2-06e5b5360278","required":false,"status":"AVAILABLE","text":null},"components":[{"character_position":0,"component":"亻","explanation":{"asset_id":null,"required":false,"status":"AVAILABLE","text":"Chưa có giải thích nguồn gốc lịch sử được xác minh (LEFT): 亻 là dạng đứng bên trái của 人 và là bộ tra chữ 你; gợi liên hệ với người. Không phải mọi thành phần đều góp nghĩa trực tiếp."},"role":"SEMANTIC_RADICAL"},{"character_position":0,"component":"尔","explanation":{"asset_id":null,"required":false,"status":"AVAILABLE","text":"Chưa có giải thích nguồn gốc lịch sử được xác minh (RIGHT): Phần bên phải được viết là 尔. Chỉ dùng để nhận diện cấu trúc ở bài này; không đọc 你 theo cách đọc hiện đại của 尔."},"role":"STRUCTURAL"}],"examples":{"asset_id":null,"required":false,"status":"AVAILABLE","text":"你喝茶吗？\nNǐ hē chá ma?\nBạn có uống trà không?"},"notes":{"asset_id":null,"required":false,"status":"AVAILABLE","text":"你 dùng để gọi người đang nói chuyện với mình: bạn, cậu. nǐ có thanh 3. Khi hai âm tiết thanh 3 đứng liền nhau, thanh 3 đầu được đọc như thanh 2: 你好 thường đọc ní hǎo. Pinyin từ điển vẫn ghi nǐ hǎo. Mẫu âm ở bài này là nǐ đọc riêng.\n\nGhi công tư liệu:\nWei Gao, Vion Nicolas — The Shtooka Project; original bytes, no changes. Nguồn: https://commons.wikimedia.org/wiki/File:Zh-n%C7%90.ogg. Giấy phép: https://creativecommons.org/licenses/by/2.0/fr/.\nWikic — Wikimedia Commons CJK Stroke Order Project; original bytes, no changes. Nguồn: https://commons.wikimedia.org/wiki/File:%E4%BD%A0-order.gif. Giấy phép: https://creativecommons.org/licenses/by/3.0/."},"schema_version":1,"stroke_order":{"asset_id":"f09090d2-0629-5b9b-b9ef-388b406e6a28","required":false,"status":"AVAILABLE","text":null},"vocabulary":[{"content_version":1,"vocabulary_id":"e611f2a1-17bb-5215-8862-7f69f32ca0fb"}]},"node_type":"NEW_WORD","position":1,"section":"hsk-0","title":"你","visual":{}},{"id":"d666409e-79bc-5f1a-b137-65f900dcfcfd","lesson":{"activities":[{"automatic_snapping":false,"correct_option":null,"evaluation":"PARTICIPATION","id":"2dfdf974-a898-508b-9249-e2471117a186","kind":"INTRODUCTION","options":[],"preserve_freehand":true,"prompt":"Đọc từ và nghĩa tiếng Việt.","repetitions":1,"required":true},{"automatic_snapping":false,"correct_option":null,"evaluation":"PARTICIPATION","id":"4c2c32b2-c302-5d74-8f4f-01ef7355318c","kind":"STROKE_ORDER","options":[],"preserve_freehand":true,"prompt":"Quan sát thứ tự nét của toàn bộ từ.","repetitions":1,"required":true},{"automatic_snapping":false,"correct_option":null,"evaluation":"PARTICIPATION","id":"d3fa806e-335c-5755-8d9b-a5bee55e78ca","kind":"HANDWRITING","options":[],"preserve_freehand":true,"prompt":"Viết tự do từng chữ; giữ nguyên các nét đã viết.","repetitions":1,"required":true},{"automatic_snapping":false,"correct_option":null,"evaluation":"PARTICIPATION","id":"9f91e169-7076-5677-b566-4b9a3fddc7eb","kind":"PRONUNCIATION","options":[],"preserve_freehand":true,"prompt":"Nghe mẫu rồi đọc lại; hoạt động chỉ ghi nhận tham gia.","repetitions":2,"required":true},{"automatic_snapping":false,"correct_option":2,"evaluation":"EXACT_CHOICE","id":"49e24d90-b386-53cf-b792-9d224f86c013","kind":"QUIZ","options":["hào","hāo","hǎo"],"preserve_freehand":true,"prompt":"Chọn Pinyin của 好 (tốt).","repetitions":1,"required":true},{"automatic_snapping":false,"correct_option":0,"evaluation":"EXACT_CHOICE","id":"f0c0ecaf-13c5-5bf7-8be3-1604d79a00dd","kind":"QUIZ","options":["tốt","tôi","bạn"],"preserve_freehand":true,"prompt":"Chọn nghĩa của 好 (hǎo).","repetitions":1,"required":true}],"audio":{"asset_id":"e495a62c-2b69-5772-85aa-9aea529ee6da","required":false,"status":"AVAILABLE","text":null},"components":[{"character_position":0,"component":"女","explanation":{"asset_id":null,"required":false,"status":"AVAILABLE","text":"Chưa có giải thích nguồn gốc lịch sử được xác minh (LEFT): 女 ở bên trái và là bộ tra chữ 好. Nhận diện vị trí của bộ; không suy diễn một câu chuyện lịch sử hay quan niệm về con người từ nghĩa hiện đại. Trong chữ 好, nét ngang cuối của bộ 女 được viết thành nét hất (提), hướng lên bên phải."},"role":"SEMANTIC_RADICAL"},{"character_position":0,"component":"子","explanation":{"asset_id":null,"required":false,"status":"AVAILABLE","text":"Chưa có giải thích nguồn gốc lịch sử được xác minh (RIGHT): 子 ở bên phải. Nhận diện phần 子 để ghi nhớ cấu trúc trái–phải của chữ 好; xem mẫu thứ tự nét khi tập viết."},"role":"STRUCTURAL"}],"examples":{"asset_id":null,"required":false,"status":"AVAILABLE","text":"我很好。\nWǒ hěn hǎo.\nTôi khỏe."},"notes":{"asset_id":null,"required":false,"status":"AVAILABLE","text":"Bài này học 好 đọc hǎo (thanh 3): tốt, ổn; trong 我很好 có thể hiểu là khỏe. Không nhầm với cách đọc hào (thanh 4, nghĩa thích) thuộc một cách đọc/nghĩa khác. Ví dụ ghi thanh từ điển, không phải hướng dẫn chi tiết biến điệu.\n\nGhi công tư liệu:\nWei Gao, Vion Nicolas — The Shtooka Project; original bytes, no changes. Nguồn: https://commons.wikimedia.org/wiki/File:Zh-h%C7%8Eo.ogg. Giấy phép: https://creativecommons.org/licenses/by/2.0/fr/.\nWikic — Wikimedia Commons CJK Stroke Order Project; original bytes, no changes. Nguồn: https://commons.wikimedia.org/wiki/File:%E5%A5%BD-order.gif. Giấy phép: https://creativecommons.org/licenses/by/3.0/."},"schema_version":1,"stroke_order":{"asset_id":"a334cb71-17d4-5ca5-9518-6eb41ee51d4e","required":false,"status":"AVAILABLE","text":null},"vocabulary":[{"content_version":1,"vocabulary_id":"48fd5063-1606-5d90-9943-74d05d8dfc48"}]},"node_type":"NEW_WORD","position":2,"section":"hsk-0","title":"好","visual":{}},{"id":"f5b0ea02-c209-57c5-9f95-89c496eca589","lesson":{"activities":[{"automatic_snapping":false,"correct_option":null,"evaluation":"PARTICIPATION","id":"7d3369a8-fc9a-59b4-9f13-b4661352778f","kind":"INTRODUCTION","options":[],"preserve_freehand":true,"prompt":"Đọc và ôn các từ.","repetitions":1,"required":false},{"automatic_snapping":false,"correct_option":2,"evaluation":"EXACT_CHOICE","id":"b7cfaad1-55ec-518e-bf36-454a3653c574","kind":"QUIZ","options":["你","好","我"],"preserve_freehand":true,"prompt":"Chọn từ có nghĩa: tôi.","repetitions":1,"required":true},{"automatic_snapping":false,"correct_option":1,"evaluation":"EXACT_CHOICE","id":"9a8aa47b-1e6f-5593-8074-65e5fd0afd0b","kind":"QUIZ","options":["我","你","好"],"preserve_freehand":true,"prompt":"Chọn từ có nghĩa: bạn.","repetitions":1,"required":true},{"automatic_snapping":false,"correct_option":2,"evaluation":"EXACT_CHOICE","id":"796007f7-be8b-5f74-a48c-e7cc5b33304c","kind":"QUIZ","options":["我","你","好"],"preserve_freehand":true,"prompt":"Chọn từ có nghĩa: tốt.","repetitions":1,"required":true}],"audio":{"asset_id":null,"required":false,"status":"UNAVAILABLE","text":null},"components":[],"examples":{"asset_id":null,"required":false,"stat