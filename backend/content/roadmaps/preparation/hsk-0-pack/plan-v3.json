null,"status":"UNREVIEWED"},"sha256":"e8218d402c238c66f83252592d3e292e2f2bf1054a1dd138faeaa2d6afa4d570","simplified":"你","source":"https://commons.wikimedia.org/wiki/File:Zh-n%C7%90.ogg","version":1},{"attribution":"Wikic — Wikimedia Commons CJK Stroke Order Project; original bytes, no changes","byte_length":10794,"file":"sources/ni.gif","id":"252b2ba2-cad9-55db-a07b-e3c57bb47f4b","license":"https://creativecommons.org/licenses/by/3.0/","media_type":"image/gif","origin":"DATASET","pinyin_numbered":null,"provider":null,"purpose":"STROKE_ORDER","redistribution_allowed":true,"reference":{"content_version":1,"vocabulary_id":"e611f2a1-17bb-5215-8862-7f69f32ca0fb"},"review":{"content_sha256":null,"evidence":null,"reviewer":null,"status":"UNREVIEWED"},"sha256":"5468f7a33bbb9fdadaeba09c7e8b109a8265de4c3868789588e258a98224c7b0","simplified":"你","source":"https://commons.wikimedia.org/wiki/File:%E4%BD%A0-order.gif","version":1},{"attribution":"Wei Gao, Vion Nicolas — The Shtooka Project; original bytes, no changes","byte_length":13835,"file":"sources/hao.ogg","id":"236e9f82-c856-5e5b-a0b8-b6a2f6354837","license":"https://creativecommons.org/licenses/by/2.0/fr/","media_type":"audio/ogg","origin":"HUMAN_RECORDED","pinyin_numbered":"hao3","provider":null,"purpose":"AUDIO","redistribution_allowed":true,"reference":{"content_version":1,"vocabulary_id":"48fd5063-1606-5d90-9943-74d05d8dfc48"},"review":{"content_sha256":null,"evidence":null,"reviewer":null,"status":"UNREVIEWED"},"sha256":"d490fdc48559f2f374622cf1caecfccae38d5968ace53391db5866d589a4fcc3","simplified":"好","source":"https://commons.wikimedia.org/wiki/File:Zh-h%C7%8Eo.ogg","version":1},{"attribution":"Wikic — Wikimedia Commons CJK Stroke Order Project; original bytes, no changes","byte_length":13224,"file":"sources/hao.gif","id":"5fce4cd1-5b8a-56e2-bcfe-01ad8501bfb4","license":"https://creativecommons.org/licenses/by/3.0/","media_type":"image/gif","origin":"DATASET","pinyin_numbered":null,"provider":null,"purpose":"STROKE_ORDER","redistribution_allowed":true,"reference":{"content_version":1,"vocabulary_id":"48fd5063-1606-5d90-9943-74d05d8dfc48"},"review":{"content_sha256":null,"evidence":null,"reviewer":null,"status":"UNREVIEWED"},"sha256":"6f249ad0cc45054b7abb34caf6adc660fdb443947d047af77dfe9d155cfb963f","simplified":"好","source":"https://commons.wikimedia.org/wiki/File:%E5%A5%BD-order.gif","version":1}],"code":"hsk-0-preparation","enrichments":[{"components":[{"character":"我","character_position":0,"component":"戈","explanation_vi":"Có thể nhận diện phần 戈 trong hình chữ; đây cũng là bộ dùng để tra chữ. Không suy ra nghĩa ‘tôi’ bằng cách cộng nghĩa các nét hoặc thành phần.","historical_source":null,"interpretation":"ORIGIN_UNAVAILABLE","position":"OVERLAPPING","review":{"content_sha256":null,"evidence":null,"reviewer":null,"status":"UNREVIEWED"},"role":"STRUCTURAL"}],"examples":[{"audio":null,"content":{"pinyin":"Wǒ zài jiā.","simplified":"我在家。","vietnamese":"Tôi ở nhà."},"difficulty":0,"pinyin_numbered":"wo3 zai4 jia1","review":{"content_sha256":null,"evidence":null,"reviewer":null,"status":"UNREVIEWED"},"target_character_position":0}],"notes_review":{"content_sha256":null,"evidence":null,"reviewer":null,"status":"UNREVIEWED"},"notes_vi":"我 dùng để nói về bản thân: tôi, mình. wǒ có thanh 3; khi đọc riêng, nghe và nhắc lại mẫu. Âm Hán Việt ‘ngã’ không phải cách phát âm Quan thoại.\n\nGhi công tư liệu:\nWei Gao, Vion Nicolas — The Shtooka Project; original bytes, no changes. Nguồn: https://commons.wikimedia.org/wiki/File:Zh-w%C7%92.ogg. Giấy phép: https://creativecommons.org/licenses/by/2.0/fr/.\nMicheletb, Yug — Wikimedia Commons CJK Stroke Order Project; original bytes, no changes. Nguồn: https://commons.wikimedia.org/wiki/File:%E6%88%91-order.gif. Giấy phép: https://creativecommons.org/licenses/by/3.0/.","reference":{"content_version":1,"vocabulary_id":"4ae81805-45f9-5d4f-a576-2a03b4ba27c9"}},{"components":[{"character":"你","character_position":0,"component":"亻","explanation_vi":"亻 là dạng đứng bên trái của 人 và là bộ tra chữ 你; gợi liên hệ với người. Không phải mọi thành phần đều góp nghĩa trực tiếp.","historical_source":null,"interpretation":"ORIGIN_UNAVAILABLE","position":"LEFT","review":{"content_sha256":null,"evidence":null,"reviewer":null,"status":"UNREVIEWED"},"role":"SEMANTIC_RADICAL"},{"character":"你","character_position":0,"component":"尔","explanation_vi":"Phần bên phải được viết là 尔. Chỉ dùng để nhận diện cấu trúc ở bài này; không đọc 你 theo cách đọc hiện đại của 尔.","historical_source":null,"interpretation":"ORIGIN_UNAVAILABLE","position":"RIGHT","review":{"content_sha256":null,"evidence":null,"reviewer":null,"status":"UNREVIEWED"},"role":"STRUCTURAL"}],"examples":[{"audio":null,"content":{"pinyin":"Nǐ hē chá ma?","simplified":"你喝茶吗？","vietnamese":"Bạn có uống trà không?"},"difficulty":0,"pinyin_numbered":"ni3 he1 cha2 ma5","review":{"content_sha256":null,"evidence":null,"reviewer":null,"status":"UNREVIEWED"},"target_character_position":0}],"notes_review":{"content_sha256":null,"evidence":null,"reviewer":null,"status":"UNREVIEWED"},"notes_vi":"你 dùng để gọi người đang nói chuyện với mình: bạn, cậu. nǐ có thanh 3. Trong 你好, thanh đầu thường đổi khi nói; Pinyin từ điển vẫn ghi nǐ hǎo. Mẫu âm ở bài này là nǐ đọc riêng.\n\nGhi công tư liệu:\nWei Gao, Vion Nicolas — The Shtooka Project; original bytes, no changes. Nguồn: https://commons.wikimedia.org/wiki/File:Zh-n%C7%90.ogg. Giấy phép: https://creativecommons.org/licenses/by/2.0/fr/.\nWikic — Wikimedia Commons CJK Stroke Order Project; original bytes, no changes. Nguồn: https://commons.wikimedia.org/wiki/File:%E4%BD%A0-order.gif. Giấy phép: https://creativecommons.org/licenses/by/3.0/.","reference":{"content_version":1,"vocabulary_id":"e611f2a1-17bb-5215-8862-7f69f32ca0fb"}},{"components":[{"character":"好","character_position":0,"component":"女","explanation_vi":"女 ở bên trái và là bộ tra chữ 好. Nhận diện vị trí của bộ; không suy diễn một câu chuyện lịch sử hay quan niệm về con người từ nghĩa hiện đại.","historical_source":null,"interpretation":"ORIGIN_UNAVAILABLE","position":"LEFT","review":{"content_sha256":null,"evidence":null,"reviewer":null,"status":"UNREVIEWED"},"role":"SEMANTIC_RADICAL"},{"character":"好","character_position":0,"component":"子","explanation_vi":"子 ở bên phải. Khi viết trong 好, chú ý nét cuối của phần 女 nối hướng sang phải; xem mẫu thứ tự nét.","historical_source":null,"interpretation":"ORIGIN_UNAVAILABLE","position":"RIGHT","review":{"content_sha256":null,"evidence":null,"reviewer":null,"status":"UNREVIEWED"},"role":"STRUCTURAL"}],"examples":[{"audio":null,"content":{"pinyin":"Wǒ hěn hǎo.","simplified":"我很好。","vietnamese":"Tôi khỏe."},"difficulty":0,"pinyin_numbered":"wo3 hen3 hao3","review":{"content_sha256":null,"evidence":null,"reviewer":null,"status":"UNREVIEWED"},"target_character_position":2}],"notes_review":{"content_sha256":null,"evidence":null,"reviewer":null,"status":"UNREVIEWED"},"notes_vi":"Bài này học 好 đọc hǎo (thanh 3): tốt, ổn; trong 我很好 có thể hiểu là khỏe. Không nhầm với cách đọc hào (thanh 4, nghĩa thích) thuộc một cách đọc/nghĩa khác. Ví dụ ghi thanh từ điển, không phải hướng dẫn chi tiết biến điệu.\n\nGhi công tư liệu:\nWei Gao, Vion Nicolas — The Shtooka Project; original bytes, no changes. Nguồn: https://commons.wikimedia.org/wiki/File:Zh-h%C7%8Eo.ogg. Giấy phép: https://creativecommons.org/licenses/by/2.0/fr/.\nWikic — Wikimedia Commons CJK Stroke Order Project; original bytes, no changes. Nguồn: https://commons.wikimedia.org/wiki/File:%E5%A5%BD-order.gif. Giấy phép: https://creativecommons.org/licenses/by/3.0/.","reference":{"content_version":1,"vocabulary_id":"48fd5063-1606-5d90-9943-74d05d8dfc48"}}],"groups":[{"key":"first-three","section":"hsk-0","vocabulary":[{"content_version":1,"vocabulary_id":"4ae81805-45f9-5d4f-a576-2a03b4ba27c9"},{"content_version":1,"vocabulary_id":"e611f2a1-17bb-5215-8862-7f69f32ca0fb"},{"content_version":1,"vocabulary_id":"48fd5063-1606-5d90-9943-74d05d8dfc48"}]}],"id":"5a8aa397-65fb-5582-b6a1-93a90ad9ebe8","review_interval":3,"schema_version":1,"templates":{"choice_count":3,"components_activity":false,"handwriting":true,"pinyin_tone_distractors":true,"pronunciation":true,"pronunciation_repetitions":2,"quizzes":["PINYIN","WORD_TO_MEANING"],"review_introduction_required":false,"review_quizzes":["MEANING_TO_WORD"]},"title":"HSK 0 — Tôi, bạn và tốt","version":3}
