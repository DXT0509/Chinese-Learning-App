e":"https://commons.wikimedia.org/wiki/File:Zh-h%C7%8Eo.ogg","version":1},{"attribution":"Wikic — Wikimedia Commons CJK Stroke Order Project; original bytes, no changes","byte_length":13224,"file":"sources/hao.gif","id":"5fce4cd1-5b8a-56e2-bcfe-01ad8501bfb4","license":"https://creativecommons.org/licenses/by/3.0/","media_type":"image/gif","origin":"DATASET","pinyin_numbered":null,"provider":null,"purpose":"STROKE_ORDER","redistribution_allowed":true,"reference":{"content_version":1,"vocabulary_id":"48fd5063-1606-5d90-9943-74d05d8dfc48"},"review":{"content_sha256":"c974c4c88168fa60a6ec5aa9d33ce846cca690a9a51e659b3cbc85793ab205d2","evidence":"HSK0-EDU-REVIEW-20261102","reviewer":"dxt","status":"REVIEWED"},"sha256":"6f249ad0cc45054b7abb34caf6adc660fdb443947d047af77dfe9d155cfb963f","simplified":"好","source":"https://commons.wikimedia.org/wiki/File:%E5%A5%BD-order.gif","version":1}],"code":"hsk-0-preparation","enrichments":[{"components":[{"character":"我","character_position":0,"component":"戈","explanation_vi":"Có thể nhận diện phần 戈 trong hình chữ; đây cũng là bộ dùng để tra chữ. Không suy ra nghĩa ‘tôi’ bằng cách cộng nghĩa các nét hoặc thành phần.","historical_source":null,"interpretation":"ORIGIN_UNAVAILABLE","position":"OVERLAPPING","review":{"content_sha256":"a0eabd611df860df9eb4c1574e93a0f44a6da59d382388894c900c63008ab4b9","evidence":"HSK0-EDU-REVIEW-20261102","reviewer":"dxt","status":"REVIEWED"},"role":"STRUCTURAL"}],"examples":[{"audio":null,"content":{"pinyin":"Wǒ zài jiā.","simplified":"我在家。","vietnamese":"Tôi ở nhà."},"difficulty":0,"pinyin_numbered":"wo3 zai4 jia1","review":{"content_sha256":"05886d16094968c744d7d4e42cb2cc8e3feaabd0c6beacf8a1f342e023e73054","evidence":"HSK0-EDU-REVIEW-20261102","reviewer":"dxt","status":"REVIEWED"},"target_character_position":0}],"notes_review":{"content_sha256":"c5b1ed47ac334ee203d0d5e652ddbe4fbff5007ff9bbfb17b863486997c22ed3","evidence":"HSK0-EDU-REVIEW-20261102","reviewer":"dxt","status":"REVIEWED"},"notes_vi":"我 dùng để nói về bản thân: tôi, mình. wǒ có thanh 3; khi đọc riêng, nghe và nhắc lại mẫu. Âm Hán Việt ‘ngã’ không phải cách phát âm Quan thoại.\n\nGhi công tư liệu:\nWei Gao, Vion Nicolas — The Shtooka Project; original bytes, no changes. Nguồn: https://commons.wikimedia.org/wiki/File:Zh-w%C7%92.ogg. Giấy phép: https://creativecommons.org/licenses/by/2.0/fr/.\nMicheletb, Yug — Wikimedia Commons CJK Stroke Order Project; original bytes, no changes. Nguồn: https://commons.wikimedia.org/wiki/File:%E6%88%91-order.gif. Giấy phép: https://creativecommons.org/licenses/by/3.0/.","reference":{"content_version":1,"vocabulary_id":"4ae81805-45f9-5d4f-a576-2a03b4ba27c9"}},{"components":[{"character":"你","character_position":0,"component":"亻","explanation_vi":"亻 là dạng đứng bên trái của 人 và là bộ tra chữ 你; gợi liên hệ với người. Không phải mọi thành phần đều góp nghĩa trực tiếp.","historical_source":null,"interpretation":"ORIGIN_UNAVAILABLE","position":"LEFT","review":{"content_sha256":"c8b380b5aa5c12fd88a9d8c38cc685497143119e7dd3402ec00404eac73daf1a","evidence":"HSK0-EDU-REVIEW-20261102","reviewer":"dxt","status":"REVIEWED"},"role":"SEMANTIC_RADICAL"},{"character":"你","character_position":0,"component":"尔","explanation_vi":"Phần bên phải được viết là 尔. Chỉ dùng để nhận diện cấu trúc ở bài này; không đọc 你 theo cách đọc hiện đại của 尔.","historical_source":null,"interpretation":"ORIGIN_UNAVAILABLE","position":"RIGHT","review":{"content_sha256":"3ce47e200a424e0b6bbb0bcd22e015d6554c83ef4ff4ae4532042013d203130c","evidence":"HSK0-EDU-REVIEW-20261102","reviewer":"dxt","status":"REVIEWED"},"role":"STRUCTURAL"}],"examples":[{"audio":null,"content":{"pinyin":"Nǐ hē chá ma?","simplified":"你喝茶吗？","vietnamese":"Bạn có uống trà không?"},"difficulty":0,"pinyin_numbered":"ni3 he1 cha2 ma5","review":{"content_sha256":"8ac59e6122f8425577eeb18304b00f3848910669cbe99070ca2f0c95030db85b","evidence":"HSK0-EDU-REVIEW-20261102","reviewer":"dxt","status":"REVIEWED"},"target_character_position":0}],"notes_review":{"content_sha256":"05798320f3da8c7cc64824a3b5de0097b90642129a5386d8beedce58e404aaea","evidence":"HSK0-EDU-REVIEW-20261102","reviewer":"dxt","status":"REVIEWED"},"notes_vi":"你 dùng để gọi người đang nói chuyện với mình: bạn, cậu. nǐ có thanh 3. Khi hai âm tiết thanh 3 đứng liền nhau, thanh 3 đầu được đọc như thanh 2: 你好 thường đọc ní hǎo. Pinyin từ điển vẫn ghi nǐ hǎo. Mẫu âm ở bài này là nǐ đọc riêng.\n\nGhi công tư liệu:\nWei Gao, Vion Nicolas — The Shtooka Project; original bytes, no changes. Nguồn: https://commons.wikimedia.org/wiki/File:Zh-n%C7%90.ogg. Giấy phép: https://creativecommons.org/licenses/by/2.0/fr/.\nWikic — Wikimedia Commons CJK Stroke Order Project; original bytes, no changes. Nguồn: https://commons.wikimedia.org/wiki/File:%E4%BD%A0-order.gif. Giấy phép: https://creativecommons.org/licenses/by/3.0/.","reference":{"content_version":1,"vocabulary_id":"e611f2a1-17bb-5215-8862-7f69f32ca0fb"}},{"components":[{"character":"好","character_position":0,"component":"女","explanation_vi":"女 ở bên trái và là bộ tra chữ 好. Nhận diện vị trí của bộ; không suy diễn một câu chuyện lịch sử hay quan niệm về con người từ nghĩa hiện đại. Trong chữ 好, nét ngang cuối của bộ 女 được viết thành nét hất (提), hướng lên bên phải.","historical_source":null,"interpretation":"ORIGIN_UNAVAILABLE","position":"LEFT","review":{"content_sha256":"efc9c949221b15dd507804a6f3e078ecf493591afdbf7894338bf04c1b4de0b9","evidence":"HSK0-EDU-REVIEW-20261102","reviewer":"dxt","status":"REVIEWED"},"role":"SEMANTIC_RADICAL"},{"character":"好","character_position":0,"component":"子","explanation_vi":"子 ở bên phải. Nhận diện phần 子 để ghi nhớ cấu trúc trái–phải của chữ 好; xem mẫu thứ tự nét khi tập viết.","historical_source":null,"interpretation":"ORIGIN_UNAVAILABLE","position":"RIGHT","review":{"content_sha256":"6c991ed6b7bd597dd0763cf042c13e88e4006c5caf855287fe0d0d6f777a7d60","evidence":"HSK0-EDU-REVIEW-20261102","reviewer":"dxt","status":"REVIEWED"},"role":"STRUCTURAL"}],"examples":[{"audio":null,"content":{"pinyin":"Wǒ hěn hǎo.","simplified":"我很好。","vietnamese":"Tôi khỏe."},"difficulty":0,"pinyin_numbered":"wo3 hen3 hao3","review":{"content_sha256":"4ea058e4a81da8299f1004b4cb6139242d97efcaa2cecefe07f5f8ee1e817ce4","evidence":"HSK0-EDU-REVIEW-20261102","reviewer":"dxt","status":"REVIEWED"},"target_character_position":2}],"notes_review":{"content_sha256":"62b56770da1515782efef3c0368346f9a9603b5c26773d02c6db3fd4adda1e14","evidence":"HSK0-EDU-REVIEW-20261102","reviewer":"dxt","status":"REVIEWED"},"notes_vi":"Bài này học 好 đọc hǎo (thanh 3): tốt, ổn; trong 我很好 có thể hiểu là khỏe. Không nhầm với cách đọc hào (thanh 4, nghĩa thích) thuộc một cách đọc/nghĩa khác. Ví dụ ghi thanh từ điển, không phải hướng dẫn chi tiết biến điệu.\n\nGhi công tư liệu:\nWei Gao, Vion Nicolas — The Shtooka Project; original bytes, no changes. Nguồn: https://commons.wikimedia.org/wiki/File:Zh-h%C7%8Eo.ogg. Giấy phép: https://creativecommons.org/licenses/by/2.0/fr/.\nWikic — Wikimedia Commons CJK Stroke Order Project; original bytes, no changes. Nguồn: https://commons.wikimedia.org/wiki/File:%E5%A5%BD-order.gif. Giấy phép: https://creativecommons.org/licenses/by/3.0/.","reference":{"content_version":1,"vocabulary_id":"48fd5063-1606-5d90-9943-74d05d8dfc48"}}],"groups":[{"key":"first-three","section":"hsk-0","vocabulary":[{"content_version":1,"vocabulary_id":"4ae81805-45f9-5d4f-a576-2a03b4ba27c9"},{"content_version":1,"vocabulary_id":"e611f2a1-17bb-5215-8862-7f69f32ca0fb"},{"content_version":1,"vocabulary_id":"48fd5063-1606-5d90-9943-74d05d8dfc48"}]}],"id":"5a8aa397-65fb-5582-b6a1-93a90ad9ebe8","review_interval":3,"schema_version":1,"templates":{"choice_count":3,"components_activity":false,"handwriting":true,"pinyin_tone_distractors":true,"pronunciation":true,"pronunciation_repetitions":2,"quizzes":["PINYIN","WORD_TO_MEANING"],"review_introduction_required":false,"review_quizzes":["MEANING_TO_WORD"]},"title":"HSK 0 — Tôi, bạn và tốt","version":4}
