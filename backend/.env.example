ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://chinese:local-dev-only@127.0.0.1:5432/chinese_learning
# Development-only preview access also requires per-request opt-in.
ALLOW_CONTENT_PREVIEW=false
# Independent checksum-bound AI review is required in addition to this publication opt-in.
ALLOW_AI_APPROVED_VOCABULARY=false
# Separate local session notes; requires ENVIRONMENT=development and migration 0010.
ALLOW_LOCAL_CODEX_REVIEWED_VOCABULARY=false
# Default storage is backend/.content-storage, independent of working directory.
# CONTENT_STORAGE_DIR=C:/path/to/ChineseLearningApp/backend/.content-storage
