a toàn bộ từ.","repetitions":1,"required":true},{"automatic_snapping":false,"evaluation":"PARTICIPATION","id":"a4181b88-cc7b-5b12-8c29-f433ca16d5d6","kind":"HANDWRITING","options":[],"preserve_freehand":true,"prompt":"Viết tự do từng chữ; giữ nguyên các nét đã viết.","repetitions":1,"required":true},{"automatic_snapping":false,"evaluation":"PARTICIPATION","id":"7bb37d20-6a5d-5fec-8c1d-937e52c7c216","kind":"PRONUNCIATION","options":[],"preserve_freehand":true,"prompt":"Nghe mẫu rồi đọc lại; hoạt động chỉ ghi nhận tham gia.","repetitions":2,"required":true},{"automatic_snapping":false,"evaluation":"EXACT_CHOICE","id":"e2af1e79-8a41-5d80-948c-6a9c3e088195","kind":"QUIZ","options":["nī","nì","nǐ"],"preserve_freehand":true,"prompt":"Chọn Pinyin của 你 (bạn).","repetitions":1,"required":true},{"automatic_snapping":false,"evaluation":"EXACT_CHOICE","id":"29421879-795e-5fbc-b59c-0434040e3349","kind":"QUIZ","options":["tốt","tôi","bạn"],"preserve_freehand":true,"prompt":"Chọn nghĩa của 你 (nǐ).","repetitions":1,"required":true}],"audio":{"asset_id":"c5a5f1e0-e5fe-503a-a7e2-06e5b5360278","required":false,"status":"AVAILABLE","text":null},"components":[{"character_position":0,"component":"亻","explanation":{"asset_id":null,"required":false,"status":"AVAILABLE","text":"Chưa có giải thích nguồn gốc lịch sử được xác minh (LEFT): 亻 là dạng đứng bên trái của 人 và là bộ tra chữ 你; gợi liên hệ với người. Không phải mọi thành phần đều góp nghĩa trực tiếp."},"role":"SEMANTIC_RADICAL"},{"character_position":0,"component":"尔","explanation":{"asset_id":null,"required":false,"status":"AVAILABLE","text":"Chưa có giải thích nguồn gốc lịch sử được xác minh (RIGHT): Phần bên phải được viết là 尔. Chỉ dùng để nhận diện cấu trúc ở bài này; không đọc 你 theo cách đọc hiện đại của 尔."},"role":"STRUCTURAL"}],"examples":{"asset_id":null,"required":false,"status":"AVAILABLE","text":"你喝茶吗？\nNǐ hē chá ma?\nBạn có uống trà không?"},"notes":{"asset_id":null,"required":false,"status":"AVAILABLE","text":"你 dùng